#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Corry Installer launcher.
# Exit codes: 0 finished or closed by the user; 2 the preflight check failed
# (the reasons are printed, shown in a dialog and saved to
# /tmp/Corry/preflight-error.log); 4 the installer engine is not installed;
# 126/127 administrator rights were refused (pkexec); any other code comes from
# the engine itself (it stopped unexpectedly; /tmp/Corry/crash-<date>.log).
# A failed installation keeps its complete log in /tmp/Corry/install.log.
set -euo pipefail
# Corry speaks US English by default. Another language can still be chosen on
# the welcome page, or set CORRY_LANG before starting the installer.
language=${CORRY_LANG:-en_US.UTF-8}
export LANG=$language LANGUAGE=${language%%.*}
unset LC_ALL LC_MESSAGES
if [[ ! -x /usr/bin/calamares ]]; then
 echo 'Corry cannot start: the installer engine (/usr/bin/calamares) is not installed.' >&2
 exit 4
fi
log_directory=${CORRY_LOG_DIR:-/tmp/Corry}
if ! details=$(/usr/bin/python3 /usr/lib/corry/preflight.py 2>&1); then
 printf '%s\n' "$details" >&2
 # Kept for the user, to copy into a bug report or a forum question.
 saved=
 # As root, only into a folder root owns (another account's folder could hold planted links).
 owner=$(stat -c %u -- "$log_directory" 2>/dev/null || echo "$EUID")
 if [[ ! -L $log_directory ]] && [[ $EUID != 0 || $owner == 0 ]] && mkdir -p -- "$log_directory" 2>/dev/null \
    && [[ -w $log_directory ]] \
    && printf 'Corry Installer could not start (%s).\n\n%s\n' "$(date -Iseconds)" "$details" \
       > "$log_directory/preflight-error.log.$$" 2>/dev/null \
    && mv -fT -- "$log_directory/preflight-error.log.$$" "$log_directory/preflight-error.log"; then
  saved="\n\nSaved to $log_directory/preflight-error.log."
 fi
 # Show failures from the desktop too, without a terminal requirement.
 if command -v zenity >/dev/null && [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]]; then
  zenity --error --title='Corry Installer' --text="$details$saved" || true
 fi
 exit 2
fi
# No -c: that option is for testing and makes Calamares look for its QML files
# under /etc/calamares. Without it, /etc/calamares (settings, modules, branding)
# and /usr/share/calamares/qml are used, as installed by the packages.
# corry-session runs the engine and keeps its log in /tmp/Corry if it crashes.
session=/usr/lib/corry/corry-session
[[ -x $session ]] || session=/usr/bin/calamares
if [[ $EUID == 0 ]]; then exec "$session"; fi
# The installer runs as root but must reach the live user's display and sound
# server (for the background music). Debian live users have passwordless sudo,
# which can keep that environment; pkexec cannot, so it is only the fallback.
runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
if [[ -S $runtime/pulse/native ]]; then
 export PULSE_SERVER="unix:$runtime/pulse/native"
 [[ ! -f $HOME/.config/pulse/cookie ]] || export PULSE_COOKIE="$HOME/.config/pulse/cookie"
fi
export XDG_RUNTIME_DIR=$runtime PIPEWIRE_RUNTIME_DIR=$runtime
if sudo -n true 2>/dev/null; then
 exec sudo -n --preserve-env=DISPLAY,XAUTHORITY,WAYLAND_DISPLAY,XDG_RUNTIME_DIR,PIPEWIRE_RUNTIME_DIR,PULSE_SERVER,PULSE_COOKIE,LANG,LANGUAGE,QT_QPA_PLATFORM \
  "$session"
fi
exec pkexec "$session"
