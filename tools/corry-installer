#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail
# Corry speaks US English by default. Another language can still be chosen on
# the welcome page, or set CORRY_LANG before starting the installer.
language=${CORRY_LANG:-en_US.UTF-8}
export LANG=$language LANGUAGE=${language%%.*}
unset LC_ALL LC_MESSAGES
if ! details=$(/usr/bin/python3 /usr/lib/corry/preflight.py 2>&1); then
 printf '%s\n' "$details" >&2
 # Show failures from the desktop too, without a terminal requirement.
 if command -v zenity >/dev/null; then zenity --error --title='Corry Installer' --text="$details"; fi
 exit 1
fi
if [[ $EUID == 0 ]]; then exec /usr/bin/calamares -c /etc/calamares; fi
# The installer runs as root but must reach the live user's display and sound
# server (for the background music). Debian live users have passwordless sudo,
# which can keep that environment; pkexec cannot, so it is only the fallback.
runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
if [[ -S $runtime/pulse/native ]]; then
 export PULSE_SERVER="unix:$runtime/pulse/native"
 [[ ! -f $HOME/.config/pulse/cookie ]] || export PULSE_COOKIE="$HOME/.config/pulse/cookie"
fi
export XDG_RUNTIME_DIR=$runtime PIPEWIRE_RUNTIME_DIR=$runtime
if sudo -n true 2>/dev/null; then
 exec sudo -n --preserve-env=DISPLAY,XAUTHORITY,WAYLAND_DISPLAY,XDG_RUNTIME_DIR,PIPEWIRE_RUNTIME_DIR,PULSE_SERVER,PULSE_COOKIE,LANG,LANGUAGE,QT_QPA_PLATFORM \
  /usr/bin/calamares -c /etc/calamares
fi
exec pkexec /usr/bin/calamares -c /etc/calamares
