#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Put the "Install <product>" shortcut on users' desktops.
#
#   corry-desktop-icon                 current user, once (XDG autostart at login)
#   corry-desktop-icon --all-users     every user with a home, now (package postinst)
#   corry-desktop-icon --remove-all    remove the shortcuts again (package postrm)
#
# The shortcut is made executable and trusted, so GNOME, Xfce and others start it
# with a double click instead of asking first. Everything in a user's home is
# written by that user (runuser): root never follows a path a user controls.
launcher=/usr/share/applications/corry-installer.desktop
name=corry-installer.desktop

desktop_dir() { # user home
 dir=$(runuser -u "$1" -- xdg-user-dir DESKTOP 2>/dev/null || true)
 { [ -n "$dir" ] && [ "$dir" != "$2" ]; } || dir=$2/Desktop
 echo "$dir"
}

trust() { # user uid file
 bus=/run/user/$2/bus
 if command -v gio >/dev/null && [ -S "$bus" ]; then
  # Xfce trusts a launcher whose checksum it has recorded.
  runuser -u "$1" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" sh -c \
   'gio set "$1" metadata::trusted true; gio set -t string "$1" metadata::xfce-exe-checksum "$(sha256sum "$1" | cut -d" " -f1)"' \
   sh "$3" 2>/dev/null || true
 fi
}

human_users() { # name uid home, for normal login accounts
 getent passwd | while IFS=: read -r user _ uid _ _ home shell; do
  [ "$uid" -ge 1000 ] 2>/dev/null && [ "$uid" -lt 60000 ] || continue
  case "$shell" in */nologin|*/false) continue;; esac
  [ -d "$home" ] && echo "$user $uid $home"
 done
}

case "${1:-}" in
 --all-users)
  [ -f "$launcher" ] || exit 0
  human_users | while read -r user uid home; do
   dir=$(desktop_dir "$user" "$home")
   # The marker: done for this user, the login helper will not add it back if removed.
   runuser -u "$user" -- sh -c 'mkdir -p "$1" "$2" && install -m 755 "$3" "$1/$4" && : > "$2/desktop-icon-done"' \
    sh "$dir" "$home/.config/corry" "$launcher" "$name" || continue
   trust "$user" "$uid" "$dir/$name"
  done
  ;;
 --remove-all)
  human_users | while read -r user uid home; do
   file=$(desktop_dir "$user" "$home")/$name
   # Only our own shortcut, removed by its owner.
   runuser -u "$user" -- sh -c 'if [ -f "$1" ] && grep -q "^Exec=corry-installer" "$1"; then rm -f "$1"; fi' \
    sh "$file" || true
  done
  ;;
 '')
  [ -f "$launcher" ] || exit 0
  marker=${XDG_CONFIG_HOME:-$HOME/.config}/corry/desktop-icon-done
  [ -e "$marker" ] && exit 0  # The user may have removed it on purpose.
  dir=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")
  { [ -n "$dir" ] && [ "$dir" != "$HOME" ]; } || dir=$HOME/Desktop
  mkdir -p "$dir" "$(dirname "$marker")"
  install -m 755 "$launcher" "$dir/$name"
  if command -v gio >/dev/null; then
   gio set "$dir/$name" metadata::trusted true 2>/dev/null || true
   gio set -t string "$dir/$name" metadata::xfce-exe-checksum "$(sha256sum "$dir/$name" | cut -d' ' -f1)" 2>/dev/null || true
  fi
  : > "$marker"
  ;;
 *) echo "Usage: corry-desktop-icon [--all-users|--remove-all]" >&2; exit 2;;
esac
exit 0
