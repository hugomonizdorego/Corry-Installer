QWidget { font-family: "Noto Sans", "DejaVu Sans", sans-serif; color: #20394b; }
QWidget#mainApp, QDialog { background: #f6f8fb; }
QLabel { background: transparent; }
QLabel#corrySectionTitle { font-weight: 600; font-size: 11pt; }
QLabel#corryHint { color: #526a7b; font-size: 9pt; padding: 4px; }
QWidget#corryRolePicker { background: #edf4f5; border-radius: 12px; }
QPushButton, QToolButton { background: #ffffff; border: 1px solid #cad7e0; border-radius: 7px; padding: 7px 12px; min-height: 22px; }
QPushButton:hover, QToolButton:hover { background: #e7f1f2; border-color: #689d9e; }
QPushButton:pressed, QToolButton:pressed { background: #d4e7e8; }
QPushButton:focus, QToolButton:focus, QComboBox:focus, QLineEdit:focus { border: 2px solid #cb4d30; }
QPushButton:disabled, QToolButton:disabled { color: #7b8992; background: #eef1f5; border-color: #e1e6ed; }
QPushButton#view-button-next { background: #cb4d30; color: #ffffff; border-color: #cb4d30; min-width: 110px; font-weight: bold; }
QPushButton#view-button-next:hover { background: #af3c24; }
QPushButton#view-button-next:disabled { background: #e6c9c2; color: #6e514a; border-color: #e6c9c2; }
QPushButton#view-button-back { min-width: 85px; }
QComboBox, QLineEdit, QSpinBox { border: 1px solid #bdcdd9; border-radius: 6px; padding: 6px; background: #ffffff; min-height: 20px; selection-background-color: #d4e7e8; selection-color: #142c3d; }
QComboBox QAbstractItemView { background: #ffffff; selection-background-color: #d4e7e8; selection-color: #142c3d; }
QTreeView, QListWidget { background: #ffffff; alternate-background-color: #f3f7f9; border: 1px solid #d3dee5; border-radius: 7px; }
QTreeView::item, QListWidget::item { padding: 6px; }
QTreeView::item:selected, QListWidget::item:selected { background: #d4e7e8; color: #142c3d; }
QHeaderView::section { background: #edf3f6; color: #526a7b; border: none; padding: 8px; }
QGroupBox { border: 1px solid #d3dee5; border-radius: 9px; margin-top: 16px; padding-top: 12px; }
QGroupBox::title { subcontrol-origin: margin; padding: 0 6px; }
QProgressBar { border: 1px solid #c8d9de; border-radius: 8px; background: #e7edf1; min-height: 24px; text-align: center; color: #142c3d; }
QProgressBar::chunk { background: #88cfc9; border-radius: 7px; }
QToolTip { color: #ffffff; background: #142c3d; border: none; padding: 7px; }
