/* SPDX-License-Identifier: GPL-3.0-or-later */
/* Corry look: a light blue page, soft white cards (painted by CorryCard), pill
   buttons and one accent color per distribution. The placeholder colors
   #6445a4 (accent), #8a6fd0 (light accent), #4e3585 (dark accent) and #f0ecf8
   (tint) are replaced per distribution by tools/install-profile.sh. */

/* Page and text */
QWidget { font-family: "Noto Sans", "Inter", "DejaVu Sans", sans-serif; color: #1f2a44; }
QWidget#mainApp, QWidget#viewManager, QWidget#viewManagerStack, QWidget#corryPage, QWidget#corryNavigation { background: #edf3fb; }
QWidget#slideshow, QWidget#summaryStep, QWidget#requirementsChecker { background: transparent; }
QLabel { background: transparent; }
QLabel#corryPageTitle { font-size: 22pt; font-weight: 700; color: #1f2a44; }
QLabel#corryPageSubtitle { font-size: 11pt; color: #64748b; }
QLabel#corrySectionTitle { font-weight: 600; font-size: 11pt; color: #1f2a44; }
QLabel#corryHint { color: #64748b; font-size: 10pt; padding: 4px 0; }
QLabel#corryEyebrow { color: #6445a4; font-size: 9pt; font-weight: 700; letter-spacing: 1px; }
QLabel#corryBadge { color: #4e3585; background: #f0ecf8; border-radius: 9px; padding: 2px 9px; font-size: 8pt; font-weight: 700; }
QLabel#corryBadgeWarning { color: #92400e; background: #fef3c7; border-radius: 9px; padding: 2px 9px; font-size: 8pt; font-weight: 700; }
QLabel#corryBadgeMuted { color: #64748b; background: #eef2f7; border-radius: 9px; padding: 2px 9px; font-size: 8pt; font-weight: 700; }

/* Buttons: white pills; the main action is a gradient pill. */
QPushButton, QToolButton {
    background: #ffffff; color: #1f2a44; border: 1px solid #dde5f0; border-radius: 19px;
    padding: 7px 18px; min-height: 22px; font-weight: 600;
}
QPushButton:hover, QToolButton:hover { background: #f0ecf8; border-color: #6445a4; color: #4e3585; }
QPushButton:pressed, QToolButton:pressed { background: #e3e9f2; }
QPushButton:focus, QToolButton:focus { border: 2px solid #6445a4; }
QPushButton:disabled, QToolButton:disabled { color: #94a3b8; background: #f3f6fb; border-color: #e3e9f2; }
QPushButton#view-button-next {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6445a4, stop:1 #8a6fd0);
    color: #ffffff; border: none; min-width: 128px; padding: 9px 26px; font-size: 10.5pt;
}
QPushButton#view-button-next:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #4e3585, stop:1 #6445a4); color: #ffffff; }
QPushButton#view-button-next:pressed { background: #4e3585; }
QPushButton#view-button-next:focus { border: 2px solid #4e3585; }
QPushButton#view-button-next:disabled { background: #dbe3ee; color: #94a3b8; }
QPushButton#view-button-back { min-width: 96px; padding: 8px 22px; }
QPushButton#view-button-cancel { background: transparent; border-color: transparent; color: #64748b; font-weight: 500; }
QPushButton#view-button-cancel:hover { color: #4e3585; background: #f0ecf8; border-color: transparent; }
QPushButton#corryDetailsButton, QPushButton#corryRecheckButton { padding: 6px 16px; min-height: 18px; }
QPushButton#corryDetailsButton:checked { background: #f0ecf8; color: #4e3585; border-color: #6445a4; }
QToolButton#corryRoleButton { padding: 7px 10px; border-radius: 14px; }
QPushButton#corryGPartedButton { padding: 6px 16px; }

/* Fields */
QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox {
    border: 1px solid #e3e9f2; border-radius: 12px; padding: 7px 12px; background: #f5f8fd; min-height: 22px;
    selection-background-color: #f0ecf8; selection-color: #1f2a44;
}
QComboBox:hover, QLineEdit:hover, QSpinBox:hover { border-color: #c8d3e3; }
QComboBox:focus, QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 2px solid #6445a4; background: #ffffff; }
QLineEdit { min-width: 220px; }
QComboBox::drop-down { border: none; width: 30px; }
QSpinBox::up-button, QSpinBox::down-button { border: none; width: 22px; background: transparent; }
QComboBox QAbstractItemView { background: #ffffff; border: 1px solid #e3e9f2; border-radius: 12px; padding: 4px; selection-background-color: #f0ecf8; selection-color: #1f2a44; outline: none; }

/* Lists, tables, trees */
QTreeView, QListView, QListWidget, QTableView { background: #ffffff; alternate-background-color: #f8fafd; border: 1px solid #e3e9f2; border-radius: 16px; padding: 4px; outline: none; }
QTreeView::item, QListView::item, QListWidget::item { padding: 7px; border-radius: 8px; }
QTreeView::item:hover, QListView::item:hover, QListWidget::item:hover { background: #f5f8fd; }
QTreeView::item:selected, QListView::item:selected, QListWidget::item:selected { background: #f0ecf8; color: #4e3585; }
QHeaderView::section { background: transparent; color: #94a3b8; border: none; border-bottom: 1px solid #e3e9f2; padding: 9px; font-weight: 700; font-size: 9pt; letter-spacing: 0.5px; }
QWidget#requirementsChecker QListView { background: transparent; border: none; }

/* Panels inside a page card */
QFrame#corryCard, QWidget#corryRolePicker, QWidget#corryNetworkCard { background: #f5f8fd; border: none; border-radius: 16px; }
QWidget#corryNetworkCard { padding: 6px; }
QGroupBox { border: 1px solid #e3e9f2; border-radius: 16px; margin-top: 20px; padding: 16px 10px 10px 10px; background: #ffffff; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 8px; color: #64748b; font-weight: 600; }
QLabel#corrySummaryTitle { font-size: 11pt; font-weight: 700; color: #1f2a44; }
QLabel#corrySummaryBody { color: #475569; }

/* Checks, radios, switches */
QRadioButton, QCheckBox { spacing: 10px; padding: 4px 0; }
QCheckBox::indicator { width: 20px; height: 20px; border-radius: 6px; border: 2px solid #c8d3e3; background: #ffffff; }
QCheckBox::indicator:hover { border-color: #6445a4; }
QCheckBox::indicator:checked { border-color: #6445a4; background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6445a4, stop:1 #8a6fd0); }
QCheckBox::indicator:disabled { border-color: #e3e9f2; background: #f3f6fb; }
QRadioButton::indicator { width: 20px; height: 20px; border-radius: 11px; border: 2px solid #c8d3e3; background: #ffffff; }
QRadioButton::indicator:hover { border-color: #6445a4; }
QRadioButton::indicator:checked { border: 6px solid #6445a4; background: #ffffff; }
QRadioButton::indicator:disabled { border-color: #e3e9f2; background: #f3f6fb; }

/* Progress and sliders */
QProgressBar { border: none; border-radius: 6px; background: #e3e9f2; min-height: 12px; max-height: 12px; text-align: center; color: transparent; }
QProgressBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6445a4, stop:1 #8a6fd0); border-radius: 6px; }
QSlider::groove:horizontal { height: 6px; background: #e3e9f2; border-radius: 3px; }
QSlider::sub-page:horizontal { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6445a4, stop:1 #8a6fd0); border-radius: 3px; }
QSlider::handle:horizontal { width: 20px; height: 20px; margin: -7px 0; border-radius: 10px; background: #ffffff; border: 2px solid #6445a4; }

/* Scrolling */
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #cbd5e1; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #94a3b8; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #cbd5e1; border-radius: 4px; min-width: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* Install page */
QTabWidget::pane { border: none; background: transparent; }
QLabel#exec-message { color: #64748b; padding: 2px 0; }
QPlainTextEdit { background: #1f2a44; color: #e2e8f0; border-radius: 16px; padding: 10px; font-family: "DejaVu Sans Mono", monospace; }

/* Finish page */
QLabel#corryFinishedText { font-size: 12pt; color: #475569; }

/* Dialogs and tooltips */
QMessageBox, QDialog { background: #ffffff; }
QMessageBox QLabel { font-size: 11pt; color: #1f2a44; }
QMessageBox QPushButton { min-width: 110px; }
QToolTip { color: #ffffff; background: #1f2a44; border: none; border-radius: 6px; padding: 7px 9px; }

/* Corry system-components page: selectable option cards. */
QFrame#corryOption { background: #ffffff; border: 2px solid #e3e9f2; border-radius: 16px; }
QFrame#corryOption:hover { border-color: #c8d3e3; background: #fbfcfe; }
QFrame#corryOption[selected="true"] { border-color: #6445a4; background: #f8f6fc; }
QFrame#corryOption[selected="true"]:hover { border-color: #6445a4; }
QFrame#corryOption:disabled { background: #f8fafd; border-color: #eef2f7; }
QFrame#corryOption:disabled QLabel { color: #94a3b8; }
QLabel#corryOptionTitle { font-size: 11pt; font-weight: 700; color: #1f2a44; }
QLabel#corryOptionText { color: #64748b; font-size: 9.5pt; }
QLabel#corryOptionReason { color: #92400e; font-size: 9pt; }
