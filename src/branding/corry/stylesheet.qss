/* SPDX-License-Identifier: GPL-3.0-or-later; rendered by tools/branding.py */
QWidget { font-family: "Noto Sans", "DejaVu Sans", sans-serif; color: #21343d; }
QWidget#mainApp, QDialog { background: #f5f8f8; }
QLabel { background: transparent; }
QLabel#corrySectionTitle { font-weight: 600; font-size: 11pt; }
QLabel#corryHint, QLabel#corryEyebrow { color: #526970; font-size: 10pt; padding: 4px; }
QWidget#corryRolePicker { background: #e6f4f1; border-radius: 12px; }
QPushButton, QToolButton { background: white; border: 1px solid #cbd9dc; border-radius: 8px; padding: 7px 12px; min-height: 22px; }
QPushButton:hover, QToolButton:hover { background: #e6f4f1; border-color: #08786f; }
QPushButton:pressed, QToolButton:pressed { background: #9fcfc5; }
QPushButton:focus, QToolButton:focus, QComboBox:focus, QLineEdit:focus { border: 2px solid #08786f; }
QPushButton:disabled, QToolButton:disabled { color: #819096; background: #ecf0f1; border-color: #dce4e5; }
QPushButton#view-button-next { background: #08786f; color: white; border-color: #08786f; min-width: 110px; font-weight: bold; }
QPushButton#view-button-next:hover { background: #075e57; }
QPushButton#view-button-next:disabled { background: #d4e3df; color: #647b74; border-color: #d4e3df; }
QPushButton#view-button-back { min-width: 85px; }
QComboBox, QLineEdit, QSpinBox { border: 1px solid #c2d2d6; border-radius: 7px; padding: 6px; background: white; min-height: 20px; selection-background-color: #e6f4f1; selection-color: #21343d; }
QComboBox QAbstractItemView { background: white; selection-background-color: #e6f4f1; selection-color: #21343d; }
QTreeView, QListWidget { background: white; alternate-background-color: #f3f7f7; border: 1px solid #d2dfe1; border-radius: 8px; }
QTreeView::item, QListWidget::item { padding: 7px; }
QTreeView::item:selected, QListWidget::item:selected { background: #e6f4f1; color: #21343d; }
QHeaderView::section { background: #ebf2f2; color: #526970; border: none; padding: 9px; }
QGroupBox { border: 1px solid #d2dfe1; border-radius: 10px; margin-top: 16px; padding-top: 12px; }
QGroupBox::title { subcontrol-origin: margin; padding: 0 6px; }
QProgressBar { border: 1px solid #c8dad7; border-radius: 8px; background: #e7efed; min-height: 26px; text-align: center; color: #21343d; }
QProgressBar::chunk { background: #9fcfc5; border-radius: 7px; }
QToolTip { color: white; background: #21343d; border: none; padding: 7px; }
QFrame#corryCard { background: white; border: 1px solid #d2dfe1; border-radius: 16px; }
