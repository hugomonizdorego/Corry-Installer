QWidget { font-family: "Noto Sans", "DejaVu Sans", sans-serif; color: #272530; }
QWidget#mainApp, QDialog { background: #faf9fc; }
QLabel { background: transparent; }
QLabel#corrySectionTitle { font-weight: 600; font-size: 11pt; }
QLabel#corryHint { color: #74717c; font-size: 9pt; padding: 4px; }
QWidget#corryRolePicker { background: #f0ecf8; border-radius: 12px; }
QPushButton, QToolButton { background: #ffffff; border: 1px solid #dcd7e6; border-radius: 7px; padding: 7px 12px; min-height: 22px; }
QPushButton:hover, QToolButton:hover { background: #f0ecf8; border-color: #9c88bd; }
QPushButton:pressed, QToolButton:pressed { background: #e9e1f5; }
QPushButton:focus, QToolButton:focus, QComboBox:focus, QLineEdit:focus { border: 2px solid #6445a4; }
QPushButton:disabled, QToolButton:disabled { color: #7b8992; background: #eef1f5; border-color: #e1e6ed; }
QPushButton#view-button-next { background: #6445a4; color: #ffffff; border-color: #6445a4; min-width: 110px; font-weight: bold; }
QPushButton#view-button-next:hover { background: #51338d; }
QPushButton#view-button-next:disabled { background: #ddd2ef; color: #6a6079; border-color: #ddd2ef; }
QPushButton#view-button-back { min-width: 85px; }
QComboBox, QLineEdit, QSpinBox { border: 1px solid #d0c8dc; border-radius: 6px; padding: 6px; background: #ffffff; min-height: 20px; selection-background-color: #e9e1f5; selection-color: #30243f; }
QComboBox QAbstractItemView { background: #ffffff; selection-background-color: #e9e1f5; selection-color: #30243f; }
QTreeView, QListWidget { background: #ffffff; alternate-background-color: #f8f6fb; border: 1px solid #e1dce9; border-radius: 7px; }
QTreeView::item, QListWidget::item { padding: 6px; }
QTreeView::item:selected, QListWidget::item:selected { background: #e9e1f5; color: #30243f; }
QHeaderView::section { background: #f0edf5; color: #74717c; border: none; padding: 8px; }
QGroupBox { border: 1px solid #e1dce9; border-radius: 9px; margin-top: 16px; padding-top: 12px; }
QGroupBox::title { subcontrol-origin: margin; padding: 0 6px; }
QProgressBar { border: 1px solid #c8d9de; border-radius: 8px; background: #e7edf1; min-height: 24px; text-align: center; color: #30243f; }
QProgressBar::chunk { background: #a895d0; border-radius: 7px; }
QToolTip { color: #ffffff; background: #30243f; border: none; padding: 7px; }

QFrame#corryCard { background: white; border: 1px solid #e1dce9; border-radius: 16px; }
QLabel#corryEyebrow { color: #74717c; font-size: 9pt; font-weight: 600; }
