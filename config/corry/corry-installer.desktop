[Desktop Entry]
Type=Application
Name=Install System
GenericName=System Installer
Comment=Install the system on this computer, one step at a time
Exec=corry-installer
Icon=/etc/calamares/branding/corry/corry-mark.svg
Terminal=false
Categories=System;
Keywords=install;installer;setup;calamares;corry;
StartupNotify=true
