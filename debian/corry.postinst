#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e
if [ "$1" = configure ]; then
	# Calamares was removed by the package conflict. Delete the files it left
	# behind (for example its desktop autostart entry); the APT hook purges the
	# package records once dpkg has finished.
	/usr/lib/corry/remove-calamares --leftovers || true
	if dpkg-query -W -f='${db:Status-Abbrev}\n' 'calamares*' 2>/dev/null | grep -q '^rc'; then
		echo "Corry: Calamares' files are removed; its package record is purged by the next APT run."
	fi
fi
#DEBHELPER#
exit 0
